# ElevenLabs API Configuration
ELEVENLABS_API_KEY=sk_your_api_key_here

# Access Control (required)
# Shared team password for the login page. If unset, nobody can log in.
APP_PASSWORD=choose_a_strong_team_password
# Signs the login cookie. Use a long random value and keep it stable across
# restarts/deploys, or everyone gets logged out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_value
# Days before users must log in again (default 30)
SESSION_LIFETIME_DAYS=30
# Set to true when the site is served over HTTPS (production)
SESSION_COOKIE_SECURE=false

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Web Server Configuration
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=False
